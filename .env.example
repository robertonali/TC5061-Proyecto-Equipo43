# Plantilla de variables de entorno. Copia este archivo a .env (que está en .gitignore) y
# ajusta los valores. mibici_mlops/config.py lo carga con python-dotenv.
# No pongas secretos aquí: este archivo sí se sube a Git.

# Servidor de tracking de MLflow (ver "Cómo empezar" en el README).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Modelo que sirve la API (ver "Despliegue" en el README). Vacío: usa la copia exportada en
# models/servicio/p1/. Definido: lo carga del registry al arrancar.
# MODELO_URI=models:/mibici-equipo43-p1-demanda@champion   (por alias)
# MODELO_URI=models:/mibici-equipo43-p1-demanda/3          (por número de versión)

# Modelo de P2 que sirve la misma API, con las mismas reglas que MODELO_URI. Vacío: usa la copia
# exportada en models/servicio/p2/ (`python -m mibici_mlops.api.modelo exportar --question p2`).
# MODELO_URI_P2=models:/mibici-equipo43-p2-riesgo@champion

# Modelo de P3, igual: vacío usa models/servicio/p3/ (`exportar --question p3`).
# MODELO_URI_P3=models:/mibici-equipo43-p3-clusters@champion
